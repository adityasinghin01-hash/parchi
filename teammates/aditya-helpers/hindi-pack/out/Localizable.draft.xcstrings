    "We could not match this test": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह टेस्ट नहीं मिला"
          }
        }
      }
    },
    "We could not read these lines:": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हम ये लाइनें नहीं पढ़ सके:"
          }
        }
      }
    },
    "We couldn't find \"%@\". Check the spelling, or remove this line and add the medicine by hand.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" नहीं मिला। वर्तनी जांचें, या यह लाइन हटाकर दवा खुद लिखें।"
          }
        }
      }
    },
    "We couldn't find \"%@\". Did you mean %@?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" नहीं मिला। क्या आपका मतलब %@ था?"
          }
        }
      }
    },
    "We don't have this name. You can still add it; the next screen will ask you to check it.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह नाम हमारे पास नहीं है। आप फिर भी जोड़ सकते हैं; अगली स्क्रीन पर इसे जांचने को कहा जाएगा।"
          }
        }
      }
    },
    "We hid %@ area%@ on this phone.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस फ़ोन पर %@ जगह%@ छिपाई गईं।"
          }
        }
      }
    },
    "What decides the order": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्रम किस आधार पर तय होता है"
          }
        }
      }
    },
    "What did you pay %@ in total?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने %@ को कुल कितना भुगतान किया?"
