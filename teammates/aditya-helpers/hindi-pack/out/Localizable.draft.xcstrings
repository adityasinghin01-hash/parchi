    },
    "What did you pay?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने कितना भुगतान किया?"
          }
        }
      }
    },
    "What next? Doses and refills": {
      "localizations": {
        "hi": {
          "stringUnit": {
