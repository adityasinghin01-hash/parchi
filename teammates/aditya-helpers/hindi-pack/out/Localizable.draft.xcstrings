        }
      }
    },
    "This is %@'s real website. You tap Add to cart and Pay yourself. Parchi never clicks for you.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह %@ की असली वेबसाइट है। आप खुद कार्ट में जोड़ें और भुगतान करें। पर्ची आपकी ओर से क्लिक नहीं करती।"
